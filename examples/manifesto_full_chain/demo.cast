[22.756775, "o", "\u001b[1m\u001b[34m$\u001b[0m  lex run examples/manifesto_full_chain/chain_verify.lex main \\\r\n"]
[23.464853, "o", "        --allow-effects sql,fs_write,time,io\r\n"]
[24.002717, "o", "==> verify_chain on honest 3-event log:\r\n    Ok(3) — chain intact, all 3 events verified\r\n==> deleted seq=1 (middle event) — verify_chain after deletion:\r\n    Err: chain broken: expected seq 1, found seq 2\r\n    VALIDATED: deletion detected via seq gap — hash chain works\r\n"]
[24.005234, "o", "\r\n"]
[25.513984, "o", "\u001b[2m"]
[25.514109, "o", "────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[25.514156, "o", "  \u001b[1m\u001b[32mVALIDATED\u001b[0m\r\n\r\n"]
[25.514568, "o", "  \u001b[1m§VI  \u001b[0mEffect rows enforced by type system — not by convention.\r\n       Wrong row → compile error, not a runtime surprise.\r\n\r\n  \u001b[1m§VIII\u001b[0mHash chain detects deleted event via seq gap.\r\n       Tampered log is structurally detectable.\r\n\r\n\u001b[2m"]
[25.514631, "o", "────────────────────────────────────────────────────────────────────────"]
[25.51466, "o", "\u001b[0m\r\n\r\n"]
