[9.564804, "o", "ok\r\nrequired effects: concurrent, env, fs_write, io, llm, net, proc, sql, time\r\nhint: lex run --allow-effects concurrent,env,fs_write,io,llm,net,proc,sql,time examples/manifesto_full_chain/orchestrator.lex <fn> [args]\r\n"]
[9.565567, "o", "\u001b[32m\u001b[1m✓  ok\u001b[0m  — all 9 effects verified at compile time\r\n\r\n"]
