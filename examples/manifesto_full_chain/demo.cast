[9.587751, "o", "ok\r\nrequired effects: concurrent, env, fs_write, io, llm, net, proc, sql, time\r\nhint: lex run --allow-effects concurrent,env,fs_write,io,llm,net,proc,sql,time examples/manifesto_full_chain/orchestrator.lex <fn> [args]\r\n"]
