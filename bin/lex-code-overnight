#!/usr/bin/env bash
# lex-code-overnight — build a whole package unattended, and leave a report.
#
# `lex-code --auto` ends at the first thing that needs a person: a unit that is
# stuck, a step budget that ran out, a gate that failed, a provider that blinked,
# a cap someone set. Each of those is a decision. This makes the routine ones for you,
# inside limits you set, and never spends a paid token it was not told to (it adds no
# provider of its own; whatever flags you pass are what runs).
#
#   lex-code-overnight --name=invoices --brief-file=brief.txt --ollama
#   lex-code-overnight --name=invoices --ollama           # a plan already exists: resume
#
# What it does, in order:
#   1. plan   — if there is no plan, draft one (checked and repaired by lex-code),
#               re-check it and file it. A plan that cannot be made ends the run.
#   2. rounds — drive the build; after every round decide: finished? worth
#               another round? Progress means more units verified or more
#               acceptance scenarios holding. A round with none switches a local
#               model's thinking ON (slower, but it verified a hard unit 4/4 where
#               thinking-off managed 2/4 — a small experiment, not a promise) and
#               a second one in a row stops the run. A provider that goes away is
#               waited for with backoff, not counted as a failure.
#   3. safety — before each round a half-written shared file (a kill mid-edit) is
#               put back from the last copy that parsed; a round that hangs is
#               killed at its own cap; the machine is kept awake (caffeinate).
#   4. report — always, however it ended: <project dir>/.lex/overnight/REPORT.md.
#
# Everything else on the command line goes to lex-code unchanged (--ollama,
# --max-turns=N, --repair-rounds=N, --lex-os, ...).
#
# Options (all optional except --name):
#   --name=P            the project (required)
#   --brief-file=F      the brief, needed only when no plan exists yet
#   --max-hours=N       total wall-clock limit (default 10)
#   --round-hours=N     a single round is killed after this long (default 3)
#   --stall-rounds=N    consecutive rounds without progress before stopping (default 2)
#   --steps=N           agent steps allowed per task for a local model (default 80;
#                       lex-code's own default is 60) — see LEX_MAX_STEPS. Not higher on
#                       purpose: at ~100 steps a local model's context is so long that one
#                       step outran a 5-minute provider timeout and ended a repair round
#                       with nothing applied. Many short rounds, each starting from a fresh
#                       context, beat a few long ones, so --repair-rounds defaults to 6.
#   --outage-minutes=N  how long to wait for a provider that is down (default 90)
#   --on-finish=CMD     run CMD when done (env: LEX_OVERNIGHT_PROJECT, _REASON,
#                       _REPORT) — e.g. a phone notification
#   --no-escalate       never switch thinking on
#   --no-caffeinate     do not keep the machine awake
#
# Exit status: 0 done · 1 stopped without finishing (stalled / gate failed / time)
#              2 usage · 3 no plan · 4 provider stayed down

set -u
shopt -s nullglob
TAB=$'\t'

NAME=""
BRIEF=""
MAX_HOURS=10
ROUND_HOURS=3
STALL_MAX=2
STEPS=80
OUTAGE_MIN=90
ON_FINISH=""
ESCALATE=1
CAFF=1
PASS=()

usage() { sed -n '2,/^set -u/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; }

for a in "$@"; do
  case "$a" in
    --name=*) NAME="${a#*=}" ;;
    --brief-file=*) BRIEF="${a#*=}" ;;
    --max-hours=*) MAX_HOURS="${a#*=}" ;;
    --round-hours=*) ROUND_HOURS="${a#*=}" ;;
    --stall-rounds=*) STALL_MAX="${a#*=}" ;;
    --steps=*) STEPS="${a#*=}" ;;
    --outage-minutes=*) OUTAGE_MIN="${a#*=}" ;;
    --on-finish=*) ON_FINISH="${a#*=}" ;;
    --no-escalate) ESCALATE=0 ;;
    --no-caffeinate) CAFF=0 ;;
    -h|--help) usage; exit 0 ;;
    *) PASS+=("$a") ;;
  esac
done

if [ -z "$NAME" ]; then echo "lex-code-overnight: --name=PROJECT is required (see --help)" >&2; exit 2; fi
for n in "$MAX_HOURS" "$ROUND_HOURS" "$STALL_MAX" "$STEPS" "$OUTAGE_MIN"; do
  case "$n" in ''|*[!0-9]*) echo "lex-code-overnight: numeric option expected, got '$n'" >&2; exit 2 ;; esac
done

HERE="$(cd "$(dirname "$0")" && pwd)"
LEXCODE="${LEX_CODE_OVERNIGHT_BIN:-$HERE/lex-code}"
LEX="${LEX:-lex}"
OV=".lex/overnight"
mkdir -p "$OV"

# (the LEX_OVERNIGHT_* knobs (SNAPSHOT: seconds between mid-round copies of the shared file, default 120) exist so the decision logic can be tested in seconds)
POLL="${LEX_OVERNIGHT_POLL:-5}"
BACKOFF0="${LEX_OVERNIGHT_BACKOFF:-60}"
now() { date +%s; }
START=$(now)
DEADLINE=$((START + ${LEX_OVERNIGHT_MAX_SECS:-$((MAX_HOURS * 3600))}))

say() { printf '%s  %s\n' "$(date '+%H:%M:%S')" "$*" | tee -a "$OV/supervisor.log"; }

# --- one supervisor per project directory --------------------------------------------
if ! mkdir "$OV/lock" 2>/dev/null; then
  old="$(cat "$OV/lock/pid" 2>/dev/null || true)"
  if [ -n "$old" ] && kill -0 "$old" 2>/dev/null; then
    echo "lex-code-overnight: already running here (pid $old)" >&2; exit 2
  fi
  rm -rf "$OV/lock"; mkdir "$OV/lock"
fi
echo $$ > "$OV/lock/pid"

REASON="running"
EXIT=1
finish() {
  trap - EXIT INT TERM
  pkill -9 -f -- "--project=$NAME" 2>/dev/null || true
  rm -rf "$OV/lock"
  build_all_log
  "$LEXCODE" --report="$NAME" --log="$OV/all.log" --rounds="$OV/rounds.tsv" > "$OV/REPORT.md" 2>/dev/null || \
    echo "(the report could not be generated; the logs are in $OV/)" > "$OV/REPORT.md"
  say "finished: $REASON — report: $OV/REPORT.md"
  if [ -n "$ON_FINISH" ]; then
    LEX_OVERNIGHT_PROJECT="$NAME" LEX_OVERNIGHT_REASON="$REASON" LEX_OVERNIGHT_REPORT="$PWD/$OV/REPORT.md" bash -c "$ON_FINISH" || true
  fi
  exit "$EXIT"
}
trap 'REASON="interrupted"; EXIT=1; finish' INT TERM
trap finish EXIT

# (an explicit file list: `cat` with no arguments would sit waiting on stdin)
build_all_log() {
  local files=("$OV"/plan-*.log "$OV"/round-*.log)
  if [ "${#files[@]}" -gt 0 ]; then cat "${files[@]}" > "$OV/all.log"; else : > "$OV/all.log"; fi
}

[ "$CAFF" = 1 ] && command -v caffeinate >/dev/null 2>&1 && { caffeinate -i -w $$ & }

# --- reading what a run printed --------------------------------------------------------
last_verified() { awk -v n="$NAME" '$1=="[PROJECT]" && $2==n && $3 ~ /^[0-9]+\/[0-9]+$/ {v=$3} END{split(v,a,"/"); print a[1]+0}' "$1"; }
last_accept()   { awk '$1=="[ACCEPTANCE]" && $2 ~ /^[0-9]+\/[0-9]+$/ {v=$2} END{split(v,a,"/"); if (v=="") print "-"; else print a[1]+0}' "$1"; }
verdict_in()    { awk -F'\t' '$1=="[PROJECT_VERDICT]" {v=$2} END{print v}' "$1"; }

# --- the shared file: put back the last copy that parsed -------------------------------
# GNU stat first: there `-f` means "filesystem status" and succeeds with text that is not a
# time, so BSD-first (stat -f %m) breaks on Linux. Anything non-numeric becomes 0.
mtime_of() {
  local m
  m=$(stat -c %Y "$1" 2>/dev/null)
  case "$m" in ''|*[!0-9]*) m=$(stat -f %m "$1" 2>/dev/null) ;; esac
  case "$m" in ''|*[!0-9]*) m=0 ;; esac
  echo "$m"
}

# Remember the shared file if it parses. Called between rounds AND while a round runs
# (see run_capped): a copy that is only refreshed at round boundaries is up to a
# round old, and a kill mid-edit then restores hours of work away. That is exactly what
# happened on a real build: the round-start scaffold (every function a todo() stub) was
# put back over 2.5 hours of verified code.
snapshot_file() {
  local f="src/$NAME.lex"
  [ -f "$f" ] || return 0
  if ! "$LEX" check "$f" 2>&1 | grep -qi 'parse error'; then
    cp "$f" "$OV/last-good.lex.tmp" && mv "$OV/last-good.lex.tmp" "$OV/last-good.lex"
  fi
}

# Between rounds: if the file no longer parses (a kill mid-edit), put back the newest copy
# that did — keeping the broken one, since it is the only record of the last edit.
guard_file() {
  local f="src/$NAME.lex"
  [ -f "$f" ] || return 0
  if "$LEX" check "$f" 2>&1 | grep -qi 'parse error'; then
    if [ -f "$OV/last-good.lex" ]; then
      local keep="$OV/broken-$(now).lex" age=$(( ($(now) - $(mtime_of "$OV/last-good.lex")) / 60 ))
      cp "$f" "$keep"
      cp "$OV/last-good.lex" "$f" && say "restored $f from the newest copy that parsed, ${age} min old (a kill mid-edit left it unparseable; the broken file is kept as $keep)"
    else
      say "WARNING: $f does not parse and there is no earlier copy to restore"
    fi
  else
    snapshot_file
  fi
}

# --- running lex-code with a ceiling ---------------------------------------------------
# run_capped SECONDS LOGFILE PATTERN -- command...   (PATTERN finds its children to kill)
run_capped() {
  local cap="$1" log="$2" pat="$3"; shift 4
  ( "$@" > "$log" 2>&1; echo "EXIT $?" >> "$log" ) &
  local pid=$! waited=0 since_snap=0
  while kill -0 "$pid" 2>/dev/null; do
    sleep "$POLL"; waited=$((waited + POLL)); since_snap=$((since_snap + POLL))
    if [ "$since_snap" -ge "${LEX_OVERNIGHT_SNAPSHOT:-120}" ]; then snapshot_file; since_snap=0; fi
    if [ "$waited" -ge "$cap" ]; then
      say "the round reached its ${cap}s ceiling — killing it (verified units are kept)"
      pkill -9 -f -- "$pat" 2>/dev/null || true
      kill -9 "$pid" 2>/dev/null || true
      echo "CAPPED" >> "$log"
      break
    fi
  done
  wait "$pid" 2>/dev/null || true
}

# More, shorter repair rounds unless the caller chose a number.
have_repair_rounds=0
for a in ${PASS[@]+"${PASS[@]}"}; do case "$a" in --repair-rounds=*) have_repair_rounds=1 ;; esac; done
[ "$have_repair_rounds" = 0 ] && PASS+=("--repair-rounds=6")

is_ollama() { for a in ${PASS[@]+"${PASS[@]}"}; do [ "$a" = "--ollama" ] && return 0; done; return 1; }

ollama_up() { curl -fsS -m 5 "${OLLAMA_HOST_URL:-http://127.0.0.1:11434}/api/tags" >/dev/null 2>&1; }

# A provider that fails is waited for, not counted as a failed round. Every
# consecutive failure waits twice as long (1, 2, 4 ... capped at 15 minutes), and
# a local Ollama is also waited on until it answers. Returns 1 once the total wait
# passes --outage-minutes, or the overall deadline.
OUTAGE_SECS=0; OUTAGE_DELAY="$BACKOFF0"
wait_for_provider() {
  while true; do
    [ "$(now)" -ge "$DEADLINE" ] && return 1
    [ "$OUTAGE_SECS" -ge $((OUTAGE_MIN * 60)) ] && return 1
    say "the provider failed — waiting ${OUTAGE_DELAY}s (${OUTAGE_SECS}s so far)"
    sleep "$OUTAGE_DELAY"
    OUTAGE_SECS=$((OUTAGE_SECS + OUTAGE_DELAY)); OUTAGE_DELAY=$((OUTAGE_DELAY * 2)); [ "$OUTAGE_DELAY" -gt 900 ] && OUTAGE_DELAY=900
    if ! is_ollama || ollama_up; then return 0; fi
  done
}
outage_over() { OUTAGE_SECS=0; OUTAGE_DELAY="$BACKOFF0"; }

say "lex-code-overnight: project '$NAME', up to ${MAX_HOURS}h, rounds of at most ${ROUND_HOURS}h"

# --- 1. plan ---------------------------------------------------------------------------
PLAN=".lex/plans/$NAME.json"
if [ ! -f "$PLAN" ]; then
  if [ -z "$BRIEF" ] || [ ! -f "$BRIEF" ]; then
    say "there is no plan at $PLAN and no readable --brief-file to make one from"
    REASON="no plan"; EXIT=3; exit 3
  fi
  made=0
  for try in 1 2; do
    left=$((DEADLINE - $(now))); [ "$left" -lt "${LEX_OVERNIGHT_MIN_LEFT:-300}" ] && break
    say "planning (try $try)"
    run_capped $(( left < ROUND_HOURS*3600 ? left : ROUND_HOURS*3600 )) "$OV/plan-$try.log" "--name=$NAME" \
      -- env LEX_MAX_STEPS="$STEPS" "$LEXCODE" ${PASS[@]+"${PASS[@]}"} --package "$(cat "$BRIEF")" --name="$NAME"
    if grep -aq "^\[PLAN\]${TAB}valid${TAB}" "$OV/plan-$try.log"; then made=1; break; fi
    say "the plan did not pass validation on try $try"
  done
  if [ "$made" != 1 ]; then REASON="no plan"; EXIT=3; exit 3; fi
fi
if [ ! -f ".lex/plans/$NAME.scaffold" ]; then
  if ! "$LEXCODE" --package-check="$NAME" 2>&1 | tee "$OV/plan-check.log" | grep -aq "^\[PLAN_CHECK\]${TAB}ok"; then
    say "the plan does not pass --package-check (see $OV/plan-check.log)"
    REASON="no plan"; EXIT=3; exit 3
  fi
  if ! "$LEXCODE" --package-apply="$NAME" > "$OV/plan-apply.log" 2>&1; then
    say "filing the plan failed (see $OV/plan-apply.log)"
    REASON="no plan"; EXIT=3; exit 3
  fi
  say "plan filed"
fi

# --- 2. rounds -------------------------------------------------------------------------
THINK="${OLLAMA_THINK:-false}"
round=0; best_v=-1; best_a=-1; stall=0
[ -f "$OV/rounds.tsv" ] || : > "$OV/rounds.tsv"
existing=("$OV"/round-*.log); round=${#existing[@]}

while true; do
  left=$((DEADLINE - $(now)))
  if [ "$left" -le "${LEX_OVERNIGHT_MIN_LEFT:-120}" ]; then REASON="time limit"; EXIT=1; break; fi
  round=$((round + 1))
  guard_file
  cap="${LEX_OVERNIGHT_ROUND_SECS:-$((ROUND_HOURS * 3600))}"; [ "$left" -lt "$cap" ] && cap=$left
  say "round $round (thinking $THINK, up to $((cap / 60)) min)"
  t0=$(now)
  run_capped "$cap" "$OV/round-$round.log" "--project=$NAME" \
    -- env OLLAMA_THINK="$THINK" LEX_MAX_STEPS="$STEPS" LLM_TIMEOUT_MS="${LLM_TIMEOUT_MS:-900000}" "$LEXCODE" ${PASS[@]+"${PASS[@]}"} --project="$NAME"
  t1=$(now)
  guard_file
  log="$OV/round-$round.log"
  v=$(last_verified "$log"); a=$(last_accept "$log"); verdict=$(verdict_in "$log")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$round" "$t0" "$t1" "${verdict:-none}" "$v" "$a" "$THINK" "" >> "$OV/rounds.tsv"
  build_all_log
  say "round $round ended: verdict ${verdict:-none}, $v units verified, acceptance $a"

  case "$verdict" in provider_error|error) ;; *) outage_over ;; esac
  case "$verdict" in
    done) REASON="done"; EXIT=0; break ;;
    no_plan|no_scaffold|tool_bug_suspected) REASON="$verdict (needs a person)"; EXIT=1; break ;;
    provider_error|error)
      if ! wait_for_provider; then REASON="provider stayed down"; EXIT=4; break; fi
      continue ;;
  esac

  # no verdict at all = the process died or was killed: if Ollama is gone it is an outage
  if [ -z "$verdict" ] && is_ollama && ! ollama_up; then
    if ! wait_for_provider; then REASON="provider stayed down"; EXIT=4; break; fi
    continue
  fi

  progressed=0
  [ "$v" -gt "$best_v" ] && { best_v=$v; progressed=1; }
  case "$a" in ''|-) ;; *) [ "$a" -gt "$best_a" ] && { best_a=$a; progressed=1; } ;; esac
  if [ "$progressed" = 1 ]; then
    stall=0
  else
    stall=$((stall + 1))
    if [ "$ESCALATE" = 1 ] && [ "$THINK" != "true" ]; then
      say "no progress — the next round runs with thinking on"
      THINK=true; continue
    fi
    if [ "$stall" -ge "$STALL_MAX" ]; then REASON="stalled: $stall rounds without progress"; EXIT=1; break; fi
  fi
done
exit "$EXIT"
