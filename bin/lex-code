#!/usr/bin/env sh
# Wrapper — requires `lex` CLI on PATH.
#
# Three things this has to get right, all of which `lex run FILE "$@"`
# gets wrong: the first positional after the file is read as a function
# name (so `lex-code --plan` panicked with `no function --plan`), the
# run needs a capability grant or every session refuses at the first
# sql/fs_write, and the VM's default step budget (10,000,000, a DoS
# guard for *untrusted* sandboxed snippets per `lex run --help`) kills a
# long agentic session outright with a step-limit-exceeded panic once
# enough turns or verbose-enough model output accumulate — reproduced
# live on a real multi-file build. lex-code's own process is trusted,
# long-running code, the same case `src/index_build.lex` already raises
# this for (see the README's semantic-search section) — same value, so
# a fresh terminal doesn't also need to remember a second number.
# Hence the explicit `main --`, the effect list (which is exactly what
# `lex check src/tui/main.lex` reports as required — widen it only if
# that output changes), and the step-limit override.
set -e
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# `--parallel=N`'s isolated-copy children (src/package_flow/parallel.lex)
# run with cwd inside a temp copy of the PROJECT being built, which
# never contains this tool's own bin/ — so they need this script's real
# location to invoke it, independent of cwd. Exported, not just left to
# $SCRIPT_DIR, since a child is a fresh process with its own environment.
export LEX_CODE_BIN="$SCRIPT_DIR/lex-code"
LEX_CODE_EFFECTS="${LEX_CODE_EFFECTS:-approval,concurrent,crypto,env,fs_read,fs_walk,fs_write,io,llm,net,proc,random,sql,stream,time}"
LEX_CODE_MAX_STEPS="${LEX_CODE_MAX_STEPS:-20000000000}"

# `--lex-os`: re-invoke this same command mediated through `lex-os exec`
# (see README's "Running under lex-os") instead of running directly —
# lex-os is the OUTER, host-level sandbox; LEX_CODE_EFFECTS above is the
# separate, INNER one the Lex VM itself enforces. Filtered out of "$@"
# here with a shift/set-loop rather than string-splitting, since a real
# task string routinely has spaces in it. `LEX_OS_SIMULATED=1` (default
# unset) adds `--simulated`, since the real Firecracker perimeter needs a
# KVM host and refuses rather than silently downgrading.
lex_os_mode=0
orig_count=$#
i=0
while [ "$i" -lt "$orig_count" ]; do
  a="$1"
  shift
  if [ "$a" = "--lex-os" ]; then
    lex_os_mode=1
  else
    set -- "$@" "$a"
  fi
  i=$((i + 1))
done

if [ "$lex_os_mode" = "1" ]; then
  command -v lex-os >/dev/null 2>&1 || {
    echo "lex-os not found on PATH — see README's 'Running under lex-os' for how to build it" >&2
    exit 1
  }
  LEX_OS_MANIFEST="${LEX_OS_MANIFEST:-$SCRIPT_DIR/../lex-os/manifest.json}"
  if [ "${LEX_OS_SIMULATED:-}" = "1" ]; then
    exec lex-os exec --simulated --manifest "$LEX_OS_MANIFEST" -- "$0" "$@"
  else
    exec lex-os exec --manifest "$LEX_OS_MANIFEST" -- "$0" "$@"
  fi
fi

# --<provider>-model=X and the generic --model=X: every env-var-driven
# provider (ollama/litellm/vllm/lex-gpu/opencode — see their *_model()
# in src/tools/index.lex and lex-llm/providers.lex) already reads a model
# override from its own env var, but only if the caller remembers to
# export it before invoking this script. These flags do that export, so
# the model can be picked on the same command line as the provider
# instead of in a separate `export` beforehand. `--model=` alone resolves
# against whichever provider flag is present, using the exact same
# first-match precedence as select_provider_tag in src/tui/main.lex
# (mistral > openai > google > vertex > litellm > ollama > vllm >
# lex-gpu > opencode, default litellm). anthropic/openai/mistral/
# google/vertex build their model from a fixed constructor
# (prov.gpt4o() etc. in src/agents/*.lex), not an env var, so there is
# nothing to override for them yet — --model with one of those flags is
# a hard error rather than a silent no-op.
has_mistral=0; has_openai=0; has_google=0; has_vertex=0; has_litellm=0
has_ollama=0; has_vllm=0; has_lexgpu=0; has_opencode=0
generic_model=""
orig_count=$#
i=0
while [ "$i" -lt "$orig_count" ]; do
  a="$1"
  shift
  case "$a" in
    --opencode-model=*) export OPENCODE_MODEL="${a#--opencode-model=}" ;;
    --ollama-model=*) export OLLAMA_MODEL="${a#--ollama-model=}" ;;
    --litellm-model=*) export LITELLM_MODEL="${a#--litellm-model=}" ;;
    --vllm-model=*) export VLLM_MODEL="${a#--vllm-model=}" ;;
    --lex-gpu-model=*) export LEX_GPU_MODEL="${a#--lex-gpu-model=}" ;;
    --model=*) generic_model="${a#--model=}" ;;
    --mistral) has_mistral=1; set -- "$@" "$a" ;;
    --openai) has_openai=1; set -- "$@" "$a" ;;
    --google) has_google=1; set -- "$@" "$a" ;;
    --vertex) has_vertex=1; set -- "$@" "$a" ;;
    --litellm) has_litellm=1; set -- "$@" "$a" ;;
    --ollama) has_ollama=1; set -- "$@" "$a" ;;
    --vllm) has_vllm=1; set -- "$@" "$a" ;;
    --lex-gpu) has_lexgpu=1; set -- "$@" "$a" ;;
    --opencode) has_opencode=1; set -- "$@" "$a" ;;
    *) set -- "$@" "$a" ;;
  esac
  i=$((i + 1))
done

if [ -n "$generic_model" ]; then
  if [ "$has_mistral" = 1 ] || [ "$has_openai" = 1 ] || [ "$has_google" = 1 ] || [ "$has_vertex" = 1 ]; then
    echo "lex-code: --model is not supported yet with --mistral/--openai/--google/--vertex (their model is a fixed constructor in src/agents/*.lex, not an env var) — drop --model or switch providers" >&2
    exit 1
  elif [ "$has_litellm" = 1 ]; then
    export LITELLM_MODEL="$generic_model"
  elif [ "$has_ollama" = 1 ]; then
    export OLLAMA_MODEL="$generic_model"
  elif [ "$has_vllm" = 1 ]; then
    export VLLM_MODEL="$generic_model"
  elif [ "$has_lexgpu" = 1 ]; then
    export LEX_GPU_MODEL="$generic_model"
  elif [ "$has_opencode" = 1 ]; then
    export OPENCODE_MODEL="$generic_model"
  else
    export LITELLM_MODEL="$generic_model"
  fi
fi

exec lex run --max-steps "$LEX_CODE_MAX_STEPS" --allow-effects "$LEX_CODE_EFFECTS" \
  "$SCRIPT_DIR/../src/tui/main.lex" main -- "$@"
